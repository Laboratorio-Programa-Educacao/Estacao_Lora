#include <Wire.h>
#include <RTClib.h>
#include <Adafruit_BMP280.h>
#include "Adafruit_HTU21DF.h"
#include <HardwareSerial.h>
#include "esp_sleep.h"

#define SDA_PIN 21
#define SCL_PIN 22
#define RADIO_RX 16   
#define RADIO_TX 17   
#define RADIO_BAUD 9600

#define INTERVALO_S 600UL // 10 minutos (600 segundos)

HardwareSerial Radio(2);
Adafruit_BMP280 bmp;
Adafruit_HTU21DF htu;
RTC_DS3231 rtc;

RTC_DATA_ATTR uint32_t numeroCiclo = 0;

void destravaI2C() {
  pinMode(SDA_PIN, INPUT_PULLUP);
  pinMode(SCL_PIN, OUTPUT);
  for (int i = 0; i < 9; i++) {
    digitalWrite(SCL_PIN, LOW);
    delayMicroseconds(10);
    digitalWrite(SCL_PIN, HIGH);
    delayMicroseconds(10);
  }
  pinMode(SCL_PIN, INPUT_PULLUP);
}

void setup() {
  Serial.begin(115200);
  delay(500);

  numeroCiclo++;

  // Mensagem de cabeçalho (Apenas se houver Monitor Serial conectado no PC)
  if (Serial) {
    Serial.printf("\n=== Estacao Transmissora - Ciclo #%lu ===\n", (unsigned long)numeroCiclo);
  }

  // 1. Destrava I2C e Inicia RTC
  destravaI2C();
  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setTimeOut(1000);
  delay(100);

  bool rtcOk = rtc.begin();

  if (rtcOk) {
    DateTime agora = rtc.now();
    if (agora.year() < 2024 || agora.year() > 2035 || rtc.lostPower()) {
      rtc.adjust(DateTime(F(__DATE__), F(__TIME__)));
      delay(100);
      if (Serial) Serial.println("[RTC] Horario reajustado com sucesso.");
    }
  } else if (Serial) {
    Serial.println("[ERRO] RTC DS3231 nao encontrado!");
  }

  // 2. Inicia Rádio e Sensores
  Radio.begin(RADIO_BAUD, SERIAL_8N1, RADIO_RX, RADIO_TX);
  delay(300);

  bool bmpOk = bmp.begin(0x76) || bmp.begin(0x77);
  if (bmpOk) {
    bmp.setSampling(Adafruit_BMP280::MODE_FORCED, Adafruit_BMP280::SAMPLING_X2,
                    Adafruit_BMP280::SAMPLING_X16, Adafruit_BMP280::FILTER_OFF);
  } else if (Serial) {
    Serial.println("[ERRO] BMP280 nao encontrado!");
  }

  bool htuOk = htu.begin();
  if (!htuOk && Serial) {
    Serial.println("[ERRO] HTU21D nao encontrado!");
  }

  int totalErros = (!bmpOk) + (!htuOk);

  // 3. Leitura dos Sensores
  float t = NAN, h = NAN, p = NAN, tH = NAN;
  if (bmpOk && bmp.takeForcedMeasurement()) {
    t = bmp.readTemperature();
    p = bmp.readPressure() / 100.0F;
  }
  if (htuOk) {
    tH = htu.readTemperature();
    h = htu.readHumidity();
  }

  if (!isnan(t) && !isnan(tH)) t = (t + tH) / 2.0;
  else if (isnan(t)) t = tH;

  String horaStr = "N/A";
  if (rtcOk) {
    DateTime agora = rtc.now();
    char buf[30];
    snprintf(buf, sizeof(buf), "%02d/%02d/%04d %02d:%02d:%02d",
             agora.day(), agora.month(), agora.year(),
             agora.hour(), agora.minute(), agora.second());
    horaStr = String(buf);
  }

  // 4. Monta e envia o pacote de dados pelo Rádio
  String pacote = "DADOS:";
  pacote += "T="; pacote += isnan(t) ? "NAN" : String(t, 2);
  pacote += ";H="; pacote += isnan(h) ? "NAN" : String(h, 1);
  pacote += ";P="; pacote += isnan(p) ? "NAN" : String(p, 2);
  pacote += ";ERR="; pacote += String(totalErros);
  pacote += ";HORA="; pacote += horaStr;

  Radio.println(pacote);
  Radio.flush();
  
  if (Serial) {
    Serial.println("[TX] Pacote enviado: " + pacote);
  }

  // Margem necessária para o módulo E49 esvaziar o buffer e transmitir pelo ar
  delay(3000); 

  // 5. Calcula o tempo de sono até o próximo minuto redondo
  uint64_t sonoUs = 600000000ULL;
  if (rtcOk) {
    DateTime agora = rtc.now();
    uint32_t segPassados = (agora.minute() % 10) * 60 + agora.second();
    uint32_t segRestantes = INTERVALO_S - segPassados + 3; // +3s de margem
    if (segRestantes < 10) segRestantes += INTERVALO_S;
    sonoUs = (uint64_t)segRestantes * 1000000ULL;

    if (Serial) {
      Serial.printf("Dormindo %lu segundos ate a proxima marcacao.\n", 
                    (unsigned long)(sonoUs / 1000000ULL));
      Serial.flush();
    }
  }

  esp_sleep_enable_timer_wakeup(sonoUs);
  esp_deep_sleep_start();
}

void loop() {}
